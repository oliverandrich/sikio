<!DOCTYPE html>
<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<html lang={assigns[:locale] || SikioWeb.Locale.default_locale()}>
  <head>
    <meta charset="utf-8" />
    <%!-- The whole screen, so iOS reports its safe areas to the stylesheet. --%>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f1f5f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <.live_title default={gettext("Your time. Your queue.")} suffix=" · Sikio" phx-no-format>{assigns[:page_title]}</.live_title>
    <%!-- The s with the dot in a browser's tab, the wordmark on a home screen and when installed. --%>
    <link rel="icon" href={~p"/favicon.ico"} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={~p"/images/favicon.svg"} />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link rel="manifest" href={~p"/manifest.webmanifest"} />
    <link
      rel="preload"
      href={~p"/fonts/ibm-plex-sans/ibm-plex-sans-latin-wght-normal.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="min-h-screen bg-ground text-body text-ink antialiased scheme-light dark:scheme-dark">
    <div id="page-content">{@inner_content}</div>
    <%!-- Outside the navigated LiveView on purpose, so moving between pages never rebuilds the
    element that holds the media. Only rendered for a signed-in visitor, since the dock requires
    an account of its own. --%>
    <div :if={@conn.assigns[:current_account]} id="player-dock">
      {live_render(@conn, SikioWeb.PlayerDockLive)}
    </div>
  </body>
</html>
