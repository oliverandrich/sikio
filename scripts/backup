#!/usr/bin/env bash
# Uses standard PostgreSQL PG* variables; credentials are never command arguments.
set -euo pipefail
umask 077
: "${PGDATABASE:?Set PGDATABASE to the database to back up}"
if [[ $# != 1 || -e "$1" ]]; then
  echo 'Usage: scripts/backup NEW_ARCHIVE_PATH (must not already exist)' >&2
  exit 1
fi
archive=$1
temporary=$(mktemp "${archive}.partial.XXXXXX")
trap 'rm -f "$temporary"' EXIT
pg_dump --no-password --format=custom --no-owner --no-acl --file="$temporary"
pg_restore --list "$temporary" >/dev/null
# Publish atomically without replacing an existing backup, even in a race.
ln "$temporary" "$archive"
printf 'Backup created: %s\n' "$archive"
