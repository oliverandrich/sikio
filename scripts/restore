#!/usr/bin/env bash
# Restore only to a separately created, empty database with no running application.
set -euo pipefail
: "${PGDATABASE:?Set PGDATABASE to a new empty restore database}"
if [[ $# != 1 || ! -f "$1" ]]; then
  echo 'Usage: scripts/restore ARCHIVE_PATH' >&2
  exit 1
fi
objects=$(psql --no-password -X -v ON_ERROR_STOP=1 --tuples-only --no-align --command "SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname NOT LIKE 'pg_%' AND n.nspname <> 'information_schema'")
if [[ "$objects" != 0 ]]; then
  echo 'Restore refused: target database is not empty.' >&2
  exit 1
fi
pg_restore --no-password --exit-on-error --single-transaction --no-owner --no-acl --dbname="$PGDATABASE" "$1"
echo 'Restore completed. Verify the data before starting the application.'
