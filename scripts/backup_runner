#!/bin/sh
set -eu
umask 077
ops=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# A native release already contains Erlang and Elixir; no host SDK is needed.
if [ -f "$ops/../releases/start_erl.data" ]; then
  read -r erts version < "$ops/../releases/start_erl.data" || test -n "$version"
  release="$ops/../releases/$version"
  exec "$release/elixir" --boot "$release/start_clean" \
    --boot-var RELEASE_LIB "$ops/../lib" "$ops/backup_runner.exs" "$@"
fi
exec elixir "$ops/backup_runner.exs" "$@"
