# Native release: /etc/sikio/backup.env, mode 0600; NAME=value, no shell expansion.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=sikio
PGDATABASE=sikio
PGPASSFILE=/etc/sikio/pgpass
# Stable, unique identifier for THIS installation, also across host moves.
SIKIO_BACKUP_ID=sikio-production
RESTIC_REPOSITORY=/var/lib/sikio-backups/repository
RESTIC_PASSWORD_FILE=/etc/sikio/backup-secrets/local-password
SIKIO_BACKUP_STATE_DIR=/var/lib/sikio-backups/state
# Optional external repository (SFTP or S3); leave absent until configured.
# SIKIO_REMOTE_REPOSITORY=sftp:backup@backup.example.org:/backups/sikio
# SIKIO_REMOTE_PASSWORD_FILE=/etc/sikio/backup-secrets/remote-password
# Verification requires CREATEDB on the verification PostgreSQL server.
# These may point to a separate verification server; otherwise PG* above are used.
# SIKIO_VERIFY_PGHOST=127.0.0.1
# SIKIO_VERIFY_PGUSER=sikio_verifier
# SIKIO_VERIFY_PGPASSFILE=/etc/sikio/verify-pgpass
