[Unit]
Description=Sikio encrypted backup and restore verification
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=sikio
EnvironmentFile=/etc/sikio/backup.env
ExecStart=/opt/sikio/current/ops/backup_runner verify
UMask=0077
PrivateTmp=true
NoNewPrivileges=true
TimeoutStartSec=12h
