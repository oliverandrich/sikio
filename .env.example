# Copy to .env, chmod 600 .env, and replace every placeholder before starting.
# Use a hex password (openssl rand -hex 32) to avoid URL escaping in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-generated-hex
POSTGRES_DB=sikio
# Generate with: mise exec -- mix phx.gen.secret
SECRET_KEY_BASE=replace-with-generated-secret
# Keep this hostname stable: passkeys are tied to it.
PHX_HOST=sikio.example.org
SIKIO_PORT=4011
SIKIO_IMAGE_TAG=local
